{
  "name": "birthday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/x-date-pickers": "^7.28.3",
    "@react-router/dev": "^7.5.0",
    "@react-router/fs-routes": "^7.5.0",
    "@react-router/node": "^7.5.0",
    "@tanstack/react-query": "^5.74.3",
    "concurrently": "^9.1.2",
    "date-fns": "^4.1.0",
    "firebase": "^10.8.0",
    "isbot": "^5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.5.0",
    "react-router-dom": "^7.5.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-tools": "^14.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^5.1.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "scripts": {
    "dev": "CONCURRENTLY_KILL_OTHERS=true concurrently --names firebase,functions \"npm:dev:firebase\" \"npm:dev:functions\"",
    "dev:frontend": "vite",
    "dev:firebase": "firebase emulators:start",
    "dev:functions": "cd functions && npm run build:watch",
    "build": "react-router build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
